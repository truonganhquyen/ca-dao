---
// Trang tác phẩm (T-040; docs/20 mục 4): /ca-dao/{slug}, /tuc-ngu/{slug}, /thanh-ngu/{slug}… chỉ cho bài cong_khai.
// Đọc theo lớp: lớp 1 mở sẵn (nhãn, lời, hiểu trong 10 giây, nguồn gốc, dị bản); lớp 2 thu gọn bằng <details>.
// Hành động (trích dẫn, chia sẻ) thuộc T-042; Lưu, Trình chiếu thuộc Mốc C.
import KhungDoc from '../../layouts/KhungDoc.astro';
import EvidenceBadge from '../../components/EvidenceBadge.astro';
import VerseBlock from '../../components/VerseBlock.astro';
import GlossSheet from '../../components/GlossSheet.astro';
import ProvenanceBlock from '../../components/ProvenanceBlock.astro';
import VariantList from '../../components/VariantList.astro';
import { tacPhamCongKhai, thongTinTacPham, tienToTheLoai, tenNguon, tenMien, ngayVN, nhanCua, type TacPham } from '../../lib/kho';
import { LIEN_KET_GOP_Y, lichSuGitHub } from '../../lib/cau-hinh';

export async function getStaticPaths() {
  return (await tacPhamCongKhai()).map(tp => ({ params: { theLoai: tienToTheLoai(tp.the_loai), slug: tp.slug }, props: { tp } }));
}

const { tp } = Astro.props as { tp: TacPham };
const t = await thongTinTacPham(tp);
const { thamChieu } = t;

const nguonDau = thamChieu.nguon[0];
const nguonA = thamChieu.nguon.find(n => n.laIn && n.nguon.da_xac_minh_ban_in && n.trang);
const vungThamChieu = thamChieu.diBan.vung.filter(v => v !== 'khong_ro').map(v => nhanCua('vung', v)).join(', ');
// Câu giải thích của nhãn (docs/20 mục 10)
const giaiThich = {
  A: `Lời này đã được đối chiếu với ${nguonA?.nguon.ten ?? 'tư liệu in'}${nguonA?.trang ? `, trang ${nguonA.trang}` : ''}.`,
  B: `Lời này được ghi lại trực tiếp từ người kể${vungThamChieu ? ` ở ${vungThamChieu}` : ''}.`,
  C: 'Lời này do cộng đồng gửi, chưa được đối chiếu với tư liệu.',
  D: `Lời này được lưu truyền rộng rãi và lấy từ ${nguonDau ? tenNguon(nguonDau.nguon) : 'nguồn ghi bên dưới'}. Chúng tôi chưa đối chiếu với sách in. Bạn có sách? Hãy gửi số trang.`,
}[thamChieu.nhan];

const moTa = t.nghiaNgan ?? thamChieu.diBan.loi.split('\n').slice(0, 2).join(' / ');
const coLop2Nghia = t.dienGiai.length > 0 || t.nghiaDen || t.nghiaBong || t.gocKiemChung?.noiDung;
const NEO_NGUON = 'nguon-va-lich-su';
---

<KhungDoc tieuDe={`${tp.tieu_de} · ${t.theLoai} · Kho tàng Ca dao Tục ngữ Việt Nam`} moTa={moTa} noindex={t.noindex} laMau={t.laMau}>
  <article>
    <h1 class="sr-only">{t.theLoai}: {tp.tieu_de}</h1>

    {/* Lớp 1 · 1. Thể loại + nhãn bằng chứng; cờ */}
    <div class="flex flex-wrap items-center gap-x-3 gap-y-1">
      <span class="text-[0.9375rem] font-semibold uppercase tracking-wide text-nhat">{t.theLoai}</span>
      <span class="print:hidden"><EvidenceBadge nhan={thamChieu.nhan} giaiThich={giaiThich} /></span>
    </div>
    {t.coNghi && (
      <details class="mt-2 print:hidden">
        <summary class="inline-flex min-h-11 cursor-pointer list-none items-center gap-1 rounded-sm border border-nhan-co px-2 text-[0.9375rem] font-semibold text-nhan-co">
          <span aria-hidden="true">◇</span> Nghi không phải dân gian <span aria-hidden="true" class="ml-1">ⓘ</span>
        </summary>
        <p class="mt-2 text-[0.9375rem] text-nhat">
          Câu này thường được gọi là {t.theLoai.toLowerCase()}{t.coNghi.canCu ? <>, nhưng {t.coNghi.canCu}.</> : '.'}
        </p>
      </details>
    )}
    {t.tranhLuan && (
      <p class="mt-2 text-[0.9375rem] text-nhat print:hidden">
        <span class="font-semibold">Đang có tranh luận.</span> Các nhà nghiên cứu còn có những cách hiểu khác nhau về {t.tranhLuan}.
      </p>
    )}

    {/* Lớp 1 · 2. Lời bản tham chiếu */}
    <div class="mt-5">
      <p class="sr-only">Bản tham chiếu</p>
      <VerseBlock loi={thamChieu.diBan.loi} theTho={tp.the_tho} chuGiai={t.chuGiai} />
    </div>
    {t.canhBao && (
      <aside class="mt-4 rounded-sm border border-nhan-c/60 p-3 text-[0.9375rem]" aria-label="Cảnh báo nội dung">
        <p><span class="font-semibold">Lưu ý về nội dung.</span> {t.canhBao}</p>
      </aside>
    )}

    {/* Lớp 1 · 4. Hiểu trong 10 giây */}
    {t.nghiaNgan && (
      <section class="mt-6" aria-labelledby="hieu-nhanh">
        <h2 id="hieu-nhanh" class="text-[0.9375rem] font-semibold text-nhat">Hiểu trong 10 giây</h2>
        <p class="mt-1">{t.nghiaNgan}</p>
      </section>
    )}

    {/* Lớp 1 · 5. Nguồn gốc (luôn hiện) */}
    <ProvenanceBlock nhan={thamChieu.nhan} nguon={thamChieu.nguon} dongGop={thamChieu.diBan.dong_gop} neoLop2={NEO_NGUON} />
    <p class="chi-in hidden text-[0.9375rem] print:block">Trang: <span data-url-trang>{Astro.url.pathname}</span></p>

    {/* Lớp 1 · 6. Dị bản */}
    <VariantList ds={t.diBanChinh} theTho={tp.the_tho} khoi="chinh" />

    {/* Lớp 2 */}
    <div class="lop-2 mt-8 space-y-1 border-t border-nhat/30 pt-4 print:hidden">
      {(t.tinhHuong.length > 0 || t.moTaTinhHuong.length > 0) && (
        <section aria-labelledby="dung-khi" class="pb-2">
          <h2 id="dung-khi" class="text-[0.9375rem] font-semibold text-nhat">Dùng khi…</h2>
          {t.tinhHuong.length > 0 && (
            <ul class="mt-2 flex flex-wrap gap-2">
              {t.tinhHuong.map(x => <li class="rounded-full border border-nhat/40 px-3 py-1 text-[0.9375rem]">{x.tieuDe}</li>)}
            </ul>
          )}
          {t.moTaTinhHuong.length > 0 && (
            <ul class="mt-2 list-disc space-y-1 pl-5">{t.moTaTinhHuong.map(m => <li>{m}</li>)}</ul>
          )}
        </section>
      )}

      {coLop2Nghia && (
        <details>
          <summary class="min-h-11 cursor-pointer py-2"><h2 class="inline font-semibold">Nghĩa và các cách hiểu</h2></summary>
          <div class="space-y-4 pb-4">
            {t.nghiaDen && <p><span class="font-semibold">Nghĩa đen.</span> {t.nghiaDen}</p>}
            {t.nghiaBong && <p><span class="font-semibold">Nghĩa bóng.</span> {t.nghiaBong}</p>}
            {t.dienGiai.map(d => (
              <div>
                {d.gocNhin && <h3 class="font-semibold">{d.gocNhin}</h3>}
                {d.noiDung.split(/\n\s*\n/).map(doan => <p class="mt-1">{doan}</p>)}
              </div>
            ))}
            {t.gocKiemChung?.noiDung && (
              <div>
                <h3 class="font-semibold">Góc kiểm chứng: {t.gocKiemChung.ketLuan}</h3>
                <p class="mt-1">{t.gocKiemChung.noiDung}</p>
              </div>
            )}
          </div>
        </details>
      )}

      {t.dienXuong && (t.dienXuong.hinhThuc.length > 0 || t.dienXuong.boiCanh || t.dienXuong.nguoiTheHien) && (
        <details>
          <summary class="min-h-11 cursor-pointer py-2"><h2 class="inline font-semibold">Bối cảnh diễn xướng</h2></summary>
          <div class="space-y-1 pb-4">
            {t.dienXuong.hinhThuc.length > 0 && <p>Hình thức: {t.dienXuong.hinhThuc.join(', ')}.</p>}
            {t.dienXuong.nguoiTheHien && <p>Người thể hiện: {t.dienXuong.nguoiTheHien}.</p>}
            {t.dienXuong.boiCanh && <p>{t.dienXuong.boiCanh}</p>}
          </div>
        </details>
      )}

      {t.amLuat && (t.amLuat.nhip || t.amLuat.van.length > 0 || t.amLuat.ghiChu) && (
        <details>
          <summary class="min-h-11 cursor-pointer py-2"><h2 class="inline font-semibold">Âm luật</h2></summary>
          <div class="space-y-1 pb-4">
            {t.amLuat.nhip && <p>Nhịp: {t.amLuat.nhip}</p>}
            {t.amLuat.van.length > 0 && <p>Vần: {t.amLuat.van.join('; ')}</p>}
            {t.amLuat.ghiChu && <p>{t.amLuat.ghiChu}</p>}
          </div>
        </details>
      )}

      <details id={NEO_NGUON}>
        <summary class="min-h-11 cursor-pointer py-2">
          <h2 class="inline font-semibold">Nguồn và lịch sử</h2>
          {t.capNhat && <span class="text-[0.9375rem] text-nhat"> · cập nhật {ngayVN(t.capNhat)}</span>}
        </summary>
        <div class="space-y-3 pb-4 text-[0.9375rem]">
          <ul class="space-y-2">
            {t.tatCaNguon.map(n => (
              <li>
                <cite>{n.nguon.ten}</cite>
                {n.tacGia.length > 0 && <> — {n.tacGia.join(', ')}</>}
                {n.nxb && <>, {n.nxb}</>}
                {n.nam !== null && <>, {n.nam}</>}
                {n.trang && <>, tr. {n.trang}</>}
                {n.thamChieu.url && <>. <a href={n.thamChieu.url} rel="noopener">{tenMien(n.thamChieu.url)} <span aria-hidden="true">↗</span></a></>}
                {n.thamChieu.ngay_truy_cap && <>, truy cập {ngayVN(n.thamChieu.ngay_truy_cap)}</>}
                {n.thamChieu.ban_luu_tru && <> · <a href={n.thamChieu.ban_luu_tru} rel="noopener">bản lưu trữ <span aria-hidden="true">↗</span></a></>}
                {n.diBanId !== thamChieu.diBan.id && <span class="text-nhat"> (dị bản)</span>}
              </li>
            ))}
          </ul>
          {t.nguoiBienSoan && <p>Biên soạn: {t.nguoiBienSoan}.</p>}
          <p>
            {t.capNhat && <>Cập nhật lần cuối {ngayVN(t.capNhat)}. </>}
            <a href={lichSuGitHub(t.tep)} rel="noopener" class="inline-flex min-h-11 items-center">Lịch sử sửa đổi trên GitHub <span aria-hidden="true">&nbsp;↗</span></a>
          </p>
        </div>
      </details>

      <VariantList ds={t.diBanCongDong} theTho={tp.the_tho} khoi="cong_dong" />

      {t.tuCaDaoMe && (
        <p><a href={t.tuCaDaoMe} rel="noopener" class="inline-flex min-h-11 items-center">Xem thêm chú thích tại Ca dao Mẹ <span aria-hidden="true">&nbsp;↗</span></a></p>
      )}

      {t.coAi && <p class="text-[0.9375rem] text-nhat">Phần giải nghĩa có hỗ trợ của AI, đã được người biên soạn duyệt.</p>}

      {t.thieuPhan && (
        <p class="text-[0.9375rem] text-nhat">
          Bài đang được bổ sung. Bạn biết thêm? {LIEN_KET_GOP_Y ? <a href={LIEN_KET_GOP_Y}>Góp ý</a> : 'Lối góp ý sắp có.'}
        </p>
      )}

      {LIEN_KET_GOP_Y && (
        <p><a href={LIEN_KET_GOP_Y} class="inline-flex min-h-11 items-center">Ở quê bạn câu này nói khác?</a></p>
      )}
    </div>
  </article>

  <GlossSheet />
</KhungDoc>

<script>
  // Bản in ghi địa chỉ đầy đủ của trang (FR-1.11)
  document.querySelectorAll('[data-url-trang]').forEach(el => { el.textContent = location.href; });
</script>
