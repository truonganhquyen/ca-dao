---
// Khung cho các trang đọc (tác phẩm, sau này: tình huống, từ điển…): thanh trên, nội dung, thanh dưới trên điện thoại.
import KhungTrang from './KhungTrang.astro';
import BottomNav from '../components/BottomNav.astro';

interface Props {
  tieuDe: string;
  moTa: string;
  noindex?: boolean;
  /** Băng báo trang dựng từ dữ liệu giả của bộ mẫu giao diện (D-050). */
  laMau?: boolean;
}
const { tieuDe, moTa, noindex = false, laMau = false } = Astro.props;
---

<KhungTrang tieuDe={tieuDe} moTa={moTa} noindex={noindex}>
  <a href="#noi-dung" class="sr-only focus:not-sr-only focus:absolute focus:left-2 focus:top-2 focus:bg-giay focus:p-2">
    Bỏ qua, tới nội dung
  </a>
  {laMau && (
    <p class="bg-son px-4 py-2 text-center text-[0.9375rem] font-semibold text-giay print:hidden" role="note">
      Trang mẫu giao diện — dữ liệu thử, lời là chữ mẫu, không phải ca dao thật. Chỉ có ở bản xem trước.
    </p>
  )}
  <header class="border-b border-nhat/30 print:hidden">
    <div class="mx-auto flex min-h-12 max-w-[38em] items-center px-4">
      <a href="/" class="py-2 font-semibold text-muc no-underline">Kho tàng Ca dao</a>
    </div>
  </header>
  <main id="noi-dung" class="mx-auto max-w-[38em] px-4 pb-24 pt-6 sm:pb-12">
    <slot />
  </main>
  <BottomNav />
</KhungTrang>
