---
// Ô chú giải (docs/20 mục 5, FR-1.2, 1.3): điện thoại — bảng trượt từ dưới lên (≤ 45% chiều cao, không che dòng
// đang đọc); máy tính — ô nhỏ ngay dưới từ. Mở: chạm / Enter / Space. Đóng: chạm ra ngoài / Esc / nút Đóng;
// đóng xong trả focus về từ vừa chạm. Một ô mở tại một thời điểm.
// Không có JavaScript: không dùng tới ô này — chú giải hiện ở cuối khối lời (VerseBlock).
---

<dialog id="o-chu-giai" class="o-chu-giai print:hidden" aria-labelledby="o-chu-giai-tu">
  <div class="space-y-2 p-4">
    <p id="o-chu-giai-tu" class="font-semibold">
      <span data-o="tu"></span><span data-o="loai" class="font-normal text-nhat"></span>
    </p>
    <p data-o="giai-nghia"></p>
    <p data-o="nguon" class="text-[0.9375rem] text-nhat"></p>
    <p class="flex justify-end">
      <button type="button" data-o="dong" class="min-h-11 min-w-11 rounded-sm px-3 text-son">Đóng</button>
    </p>
  </div>
</dialog>

<script>
  const dlg = document.getElementById('o-chu-giai') as HTMLDialogElement | null;
  if (dlg) {
    const o = (ten: string) => dlg.querySelector<HTMLElement>(`[data-o="${ten}"]`)!;
    const mayTinh = window.matchMedia('(min-width: 640px)');
    let nutMo: HTMLButtonElement | null = null;
    let dangChuyen = false;

    // Liên kết (cho khi tắt JavaScript) → nút thật, mở ô chú giải
    document.querySelectorAll<HTMLAnchorElement>('a.tu-chu-giai').forEach(a => {
      const b = document.createElement('button');
      b.type = 'button';
      b.className = a.className;
      b.id = a.id;
      b.textContent = a.textContent;
      b.dataset.chuGiai = a.dataset.chuGiai;
      b.setAttribute('aria-haspopup', 'dialog');
      b.setAttribute('aria-expanded', 'false');
      b.setAttribute('aria-controls', 'o-chu-giai');
      a.replaceWith(b);
    });

    function mo(b: HTMLButtonElement) {
      const li = document.getElementById(b.dataset.chuGiai ?? '');
      if (!li) return;
      o('tu').textContent = li.dataset.tu ?? '';
      o('loai').textContent = li.dataset.loai ? ` · ${li.dataset.loai}` : '';
      o('giai-nghia').textContent = li.querySelector('.giai-nghia')?.textContent ?? '';
      const nguon = li.querySelector('.nguon-chu-giai');
      o('nguon').replaceChildren(...(nguon ? [...nguon.childNodes].map(n => n.cloneNode(true)) : []));
      nutMo = b;
      b.setAttribute('aria-expanded', 'true');
      if (mayTinh.matches) {
        dlg!.show();
        const r = b.getBoundingClientRect();
        const rong = dlg!.offsetWidth;
        dlg!.style.top = `${r.bottom + window.scrollY + 8}px`;
        dlg!.style.left = `${Math.max(16, Math.min(r.left + window.scrollX, window.scrollX + document.documentElement.clientWidth - rong - 16))}px`;
      } else {
        dlg!.style.top = dlg!.style.left = '';
        dlg!.showModal();
        // Bảng trượt chiếm phần dưới màn hình: kéo dòng đang đọc lên trên nó
        const r = b.getBoundingClientRect();
        const cho = window.innerHeight * 0.5;
        if (r.bottom > cho) window.scrollBy({ top: r.bottom - cho + 16, behavior: 'instant' });
      }
    }

    dlg.addEventListener('close', () => {
      nutMo?.setAttribute('aria-expanded', 'false');
      if (!dangChuyen) nutMo?.focus();
      nutMo = null;
    });
    o('dong').addEventListener('click', () => dlg.close());
    dlg.addEventListener('click', e => { if (e.target === dlg) dlg.close(); }); // chạm vào nền mờ (điện thoại)

    document.addEventListener('click', e => {
      const b = (e.target as Element).closest<HTMLButtonElement>('button.tu-chu-giai');
      if (b) {
        if (dlg.open && nutMo === b) { dlg.close(); return; }
        if (dlg.open) { dangChuyen = true; dlg.close(); dangChuyen = false; }
        mo(b);
        return;
      }
      if (dlg.open && !dlg.contains(e.target as Node)) dlg.close(); // chạm ra ngoài (máy tính)
    });
    // Ô không chặn (máy tính) không tự đóng bằng Esc như hộp thoại chặn
    document.addEventListener('keydown', e => { if (e.key === 'Escape' && dlg.open) dlg.close(); });
    // In: mở phần "Xem tiếp" của lời dài để bản in có đủ lời
    window.addEventListener('beforeprint', () => document.querySelectorAll<HTMLDetailsElement>('details.loi-tiep').forEach(d => { d.open = true; }));
  }
</script>

<style>
  .o-chu-giai {
    width: min(24rem, calc(100vw - 2rem));
    margin: 0;
    border: 1px solid color-mix(in srgb, var(--nhat) 40%, transparent);
    border-radius: 6px;
    background: var(--giay);
    color: var(--muc);
    box-shadow: 0 6px 24px rgb(0 0 0 / 0.15);
  }
  .o-chu-giai:not(:modal) {
    position: absolute;
    z-index: 20;
  }
  .o-chu-giai:modal {
    position: fixed;
    inset: auto 0 0 0;
    width: 100%;
    max-width: none;
    max-height: 45vh;
    overflow-y: auto;
    border-radius: 12px 12px 0 0;
    border-width: 1px 0 0;
  }
  .o-chu-giai::backdrop {
    background: rgb(0 0 0 / 0.25);
  }
  @media (prefers-reduced-motion: no-preference) {
    .o-chu-giai:modal[open] {
      animation: truot-len 160ms ease-out;
    }
  }
  @keyframes truot-len {
    from { transform: translateY(1.5rem); opacity: 0.6; }
    to { transform: none; opacity: 1; }
  }
</style>
