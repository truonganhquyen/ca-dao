---
// Nhãn bằng chứng như một con triện nhỏ (docs/20 mục 1, 10; FR-1.5): luôn có chữ + biểu tượng, không chỉ dựa vào màu.
// Chạm vào nhãn mở câu giải thích (<details>, không cần JavaScript).
import type { Nhan } from '../lib/kho';
import { nhanCua } from '../lib/kho';

interface Props {
  nhan: Nhan;
  /** Câu giải thích đã điền tên nguồn, số trang… */
  giaiThich: string;
}
const { nhan, giaiThich } = Astro.props;
const BIEU_TUONG: Record<Nhan, string> = { A: '✓', B: '◉', C: '◌', D: '○' };
const MAU: Record<Nhan, string> = {
  A: 'border-nhan-a text-nhan-a', B: 'border-nhan-b text-nhan-b', C: 'border-nhan-c text-nhan-c', D: 'border-nhan-d text-nhan-d',
};
---

<details class="nhan-bang-chung inline-block align-middle">
  <summary
    class:list={['inline-flex min-h-11 cursor-pointer list-none items-center gap-1 rounded-sm border px-2 text-[0.9375rem] font-semibold', MAU[nhan]]}
  >
    <span aria-hidden="true">{BIEU_TUONG[nhan]}</span>
    <span>{nhanCua('xac_thuc', nhan)}</span>
    <span aria-hidden="true" class="ml-1 text-nhat">ⓘ</span>
  </summary>
  <p class="mt-2 max-w-[34em] text-[0.9375rem] text-nhat">{giaiThich}</p>
</details>
