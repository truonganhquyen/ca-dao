---
// Khối Nguồn gốc ở lớp 1 (docs/20 mục 4.1 mục 5, mục 10; FR-1.9): luôn hiện, với mọi nhãn.
// Bài nhãn D luôn có câu "Chưa đối chiếu với sách in" và lối "Bạn có sách? Gửi số trang".
import type { Nhan, ThongTinNguon } from '../lib/kho';
import { tenNguon, tenMien, ngayVN } from '../lib/kho';
import { LIEN_KET_GOP_Y } from '../lib/cau-hinh';

interface Props {
  nhan: Nhan;
  nguon: ThongTinNguon[];
  dongGop?: string | null;
  /** id của khối "Nguồn và lịch sử" ở lớp 2 */
  neoLop2: string;
}
const { nhan, nguon, dongGop, neoLop2 } = Astro.props;
const coTrang = (n: ThongTinNguon) => n.thamChieu.trang !== undefined && n.thamChieu.trang !== null && String(n.thamChieu.trang).trim() !== '';
---

<section aria-labelledby="nguon-goc-tieu-de" class="nguon-goc mt-6 border-l-2 border-nhat/40 pl-3 text-[0.9375rem] text-nhat">
  <h2 id="nguon-goc-tieu-de" class="sr-only">Nguồn gốc</h2>
  {nguon.map(n => (
    <p>
      {n.laWeb ? (
        <>
          Lời tham khảo từ{' '}
          {n.thamChieu.url
            ? <a href={n.thamChieu.url} rel="noopener"><cite>{tenNguon(n.nguon)}</cite> ({tenMien(n.nguon.url ?? n.thamChieu.url)}) <span aria-hidden="true">↗</span></a>
            : <><cite>{tenNguon(n.nguon)}</cite> ({tenMien(n.nguon.url)})</>}
          {n.thamChieu.ngay_truy_cap && <>, truy cập {ngayVN(n.thamChieu.ngay_truy_cap)}</>}.
        </>
      ) : n.laIn && nhan === 'A' && coTrang(n) ? (
        <>Đối chiếu theo: <cite>{n.nguon.ten}</cite>, tr. {String(n.thamChieu.trang)}.</>
      ) : (
        <>Lời theo <cite>{n.nguon.ten}</cite>{coTrang(n) && <>, tr. {String(n.thamChieu.trang)}</>}.</>
      )}
    </p>
  ))}
  {nguon.length === 0 && dongGop && <p>Lời do cộng đồng gửi, chưa được đối chiếu với tư liệu.</p>}
  {nhan === 'D' && (
    <p>
      Chưa đối chiếu với sách in.{' '}
      {LIEN_KET_GOP_Y
        ? <a href={LIEN_KET_GOP_Y} class="inline-flex min-h-11 items-center">Bạn có sách? Gửi số trang ›</a>
        : <span>Bạn có sách? Gửi số trang (lối gửi sắp có).</span>}
    </p>
  )}
  <p class="print:hidden"><a href={`#${neoLop2}`} class="inline-flex min-h-11 items-center">Nguồn và lịch sử đầy đủ</a></p>
</section>
