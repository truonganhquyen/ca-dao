{
  "name": "kho-tang-ca-dao-tuc-ngu",
  "version": "0.2.0",
  "private": true,
  "description": "Kho tàng Ca dao Tục ngữ Việt Nam — website tĩnh (Astro), dữ liệu YAML, kiểm tra dữ liệu và quy trình thực thi AI agent (hướng v2)",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "npm run check:data && astro build && npm run kiem-trang",
    "preview": "astro preview",
    "check:data": "node scripts/kiem-tra-du-lieu.mjs",
    "check:astro": "astro check",
    "sinh:schema": "node scripts/sinh-tu-schema.mjs",
    "kiem-sinh": "node scripts/sinh-tu-schema.mjs --kiem",
    "test:fixtures": "node scripts/test-fixtures.mjs",
    "test:lien-ket": "node scripts/test-lien-ket.mjs",
    "test:nhat-quan": "node scripts/test-nhat-quan.mjs",
    "test:wordpress": "node scripts/test-wordpress.mjs",
    "quet:wordpress": "node scripts/quet-trang-wordpress.mjs",
    "xem-truoc:wordpress": "node scripts/xem-truoc-wordpress.mjs",
    "health": "node scripts/kiem-tra-du-lieu.mjs --suc-khoe",
    "health:json": "node scripts/kiem-tra-du-lieu.mjs --suc-khoe --json",
    "kiem-nhat-quan": "node scripts/kiem-nhat-quan.mjs",
    "kiem-lien-ket": "node scripts/kiem-lien-ket.mjs",
    "kiem-trang": "node scripts/kiem-trang.mjs",
    "quet-trang": "node scripts/quet-trang.mjs",
    "kiem-tra": "npm run check:data && npm run test:fixtures && npm run test:lien-ket && npm run test:nhat-quan && npm run kiem-nhat-quan && npm run kiem-sinh && node scripts/xuat-site-cu.mjs --kiem && npm run check:astro && astro build && npm run kiem-lien-ket && npm run kiem-trang && npm run quet-trang",
    "trang-thai": "node scripts/trang-thai.mjs",
    "viec-tiep-theo": "node scripts/viec-tiep-theo.mjs",
    "xuat:site-cu": "node scripts/xuat-site-cu.mjs"
  },
  "dependencies": {
    "astro": "7.3.8",
    "yaml": "^2.9.1"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.10.1",
    "axe-core": "4.14.0",
    "puppeteer-core": "25.13.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  }
}
