// Địa chỉ cũ của site Astro trên Cloudflare Workers (D-049). Từ T-076 site Astro ngừng: Worker này chỉ chuyển hướng
// 301 mọi đường dẫn sang site WordPress (cadao.sdigi.net); không còn phục vụ tệp tĩnh của dist/.
// Cloudflare Workers Builds vẫn chạy lệnh build (kiểm dữ liệu content/, build Astro) rồi triển khai Worker này.
// `previews`: lệnh mặc định cho nhánh khác main là `npx wrangler preview`, lệnh này bắt buộc có khối này.
{
  "name": "ca-dao",
  "main": "cloudflare/chuyen-huong.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "preview_urls": true,
  "previews": {}
}
